# Copiez ce fichier en .env et adaptez les valeurs à votre environnement.
# L'application ne charge pas automatiquement .env : exportez les variables
# dans votre terminal ou déclarez-les dans les paramètres du Space.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
# Rapidité : longueur maximale des réponses et maintien du modèle en mémoire.
OLLAMA_NUM_PREDICT=500
OLLAMA_KEEP_ALIVE=30m
# Activez uniquement pour un diagnostic local temporaire. Les réponses brutes
# peuvent contenir des questions et des extraits de documents.
RAG_DIAGNOSTICS=0
